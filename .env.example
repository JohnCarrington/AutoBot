# Copy this file to .env and fill in the real values. Never commit .env.
# No real values belong in this file.

# IG (demo account)
IG_USERNAME=
IG_PASSWORD=
IG_API_KEY=
IG_ACCOUNT_ID=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Switches (checked at start-up; described in docs/SETTINGS.md).
# The pairs switched on, comma-separated. Each needs a [pairs.<PAIR>] section
# in config/settings.toml.
PAIRS_ON=GBPUSD
# Trading hours, UK time: new trades from ... until ...
NEW_TRADES_FROM=06:00
NEW_TRADES_UNTIL=20:30
# Each strategy on or off.
STRATEGY_SLOW_GRIND=on
STRATEGY_EMA_PULLBACK=on
STRATEGY_BOLLINGER_BOUNCE=on
STRATEGY_RANGE_TRADE=on
# The stop loss sent with every trade, and the take profit sent to IG, in pips.
STOP_LOSS_PIPS=6
TAKE_PROFIT_PIPS=100
