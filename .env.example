# Copy this file to .env and fill in the real values. Never commit .env.
# No real values belong in this file.

# IG (demo account)
IG_USERNAME=
IG_PASSWORD=
IG_API_KEY=
IG_ACCOUNT_ID=

# Finnhub (the economic calendar)
FINNHUB_API_KEY=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Switches (checked at start-up; described in docs/SETTINGS.md).
# The pairs switched on, comma-separated. Each needs a [pairs.<PAIR>] section
# in config/settings.toml.
PAIRS_ON=GBPUSD
# Trading hours, UK time: new trades from ... until ...
NEW_TRADES_FROM=06:00
NEW_TRADES_UNTIL=20:30
# Each strategy on or off.
STRATEGY_SLOW_GRIND=on
STRATEGY_EMA_PULLBACK=on
STRATEGY_BOLLINGER_BOUNCE=on
# The first build's bounce (5-minute band and levels), kept and renamed alongside the hourly-pierce bounce.
STRATEGY_BOLLINGER_BOUNCE_5M=on
STRATEGY_RANGE_TRADE=on
# The breakout (design 3.5); it cannot be on while breakout.stop_loss_pips or
# breakout.take_profit_pips is 0.
STRATEGY_BREAKOUT=on
# The level reversal (design 3.6).
STRATEGY_LEVEL_REVERSAL=on
# The session strategies (design 3.7 to 3.9): the Asian range breakout, the session sweep and the New York
# open reversal ([asian_range_breakout], [session_sweep] and [new_york_open_reversal] in settings.toml).
STRATEGY_ASIAN_RANGE_BREAKOUT=on
STRATEGY_SESSION_SWEEP=on
STRATEGY_NEW_YORK_OPEN_REVERSAL=on
# The master switch: while off, everything runs and is recorded, but no order is ever sent to IG.
TRADING=off
# The stop loss sent with every trade (every strategy except the EMA pullback,
# the breakout, the slow grind and the level reversal, whose own are in settings.toml), the EMA
# pullback's own stop loss, and the take profit sent to IG, in pips.
STOP_LOSS_PIPS=6
STOP_LOSS_PIPS_EMA_PULLBACK=12
TAKE_PROFIT_PIPS=100
# The Bollinger bounce (design 3.3), off if left out: only within 60 minutes of 10:00, 14:00 or 16:00 UK
# (bounce.near_times in settings.toml).
BOUNCE_ONLY_NEAR_TIMES=off
# The Structural Trade Planner (planner/): on to run it, OBSERVE ONLY (it never affects a trade). Off if left out.
PLANNER_OBSERVE=off
# One signal, one trade (safety rule 11), off if left out: two strategies opening the same way from the same
# rejection candle give one trade; also the session sweep and New York open reversal under one view at a time.
ONE_SIGNAL_ONE_TRADE=off
# The breakout and the Asian range breakout wait for a pullback (owner, 19 November 2026): ON if left out
PULLBACK_ENTRY=on
# The EMA pullback's hours, off if left out: on = new EMA pullback trades only from NEW_TRADES_FROM to
# NEW_TRADES_UNTIL UK, and every open EMA pullback trade closed at 20:30 UK every day (nothing held overnight).
EMA_PULLBACK_TRADING_HOURS=off
# Only one EMA pullback trade open at a time, off if left out: on = while one is open, no other opens.
EMA_PULLBACK_ONE_AT_A_TIME=off
# The entry filters (owner, 21 November 2026; strategies/entry_filters.py): on if left out
HOURLY_CONTEXT=on
# Rule 2 off (owner, 21 November 2026), replaced by rule 2b, the RSI stretch, with the slow-grind trend day: on
ENTRY_NEAR_EMA8=off
RSI_STRETCH=on
TREND_DAY_RSI_OFF=on
# Johnny's exit for emerging-trend trades (owner, 21 November 2026; [emerging_ladder]): on if left out
EMERGING_LADDER=on
