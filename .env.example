# Copy this file to .env and fill in the real values. Never commit .env.
# No real values belong in this file.

# IG (demo account)
IG_USERNAME=
IG_PASSWORD=
IG_API_KEY=
IG_ACCOUNT_ID=

# Finnhub (the economic calendar)
FINNHUB_API_KEY=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Switches (checked at start-up; described in docs/SETTINGS.md).
# The pairs switched on, comma-separated. Each needs a [pairs.<PAIR>] section
# in config/settings.toml.
PAIRS_ON=GBPUSD
# Trading hours, UK time: new trades from ... until ...
NEW_TRADES_FROM=06:00
NEW_TRADES_UNTIL=20:30
# Each strategy on or off.
STRATEGY_SLOW_GRIND=on
STRATEGY_EMA_PULLBACK=on
STRATEGY_BOLLINGER_BOUNCE=on
STRATEGY_RANGE_TRADE=on
# The breakout (design 3.5); it cannot be on while breakout.stop_loss_pips or
# breakout.take_profit_pips is 0.
STRATEGY_BREAKOUT=on
# The level reversal (design 3.6).
STRATEGY_LEVEL_REVERSAL=on
# The stop loss sent with every trade (every strategy except the EMA pullback,
# the breakout, the slow grind and the level reversal, whose own are in settings.toml), the EMA
# pullback's own stop loss, and the take profit sent to IG, in pips.
STOP_LOSS_PIPS=6
STOP_LOSS_PIPS_EMA_PULLBACK=12
TAKE_PROFIT_PIPS=100
